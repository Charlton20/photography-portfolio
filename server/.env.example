# Copy this file to .env and fill it in. Never commit .env.

# Postgres connection string from Neon (Dashboard > Connect), ends in ?sslmode=require
DATABASE_URL=

# Any long random string. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Where this server runs
BETTER_AUTH_URL=http://localhost:3000

# Where the React site runs, with the trailing slash
CLIENT_URL=http://localhost:5173/photography-portfolio/

# Stripe Dashboard (Test mode) > Developers > API keys > Secret key
STRIPE_SECRET_KEY=sk_test_
# Printed by `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_
